<?xml version="1.0" encoding="utf-8"?>
<!--
   ISA Eye backs up by exporting a .isabackup file from Help. Android Auto Backup and device
   transfer are disabled: the database is encrypted with a Keystore key that never leaves the
   device, so a restored copy could not be opened anyway. The explicit excludes also cover OEM
   device-transfer implementations that ignore android:allowBackup="false".
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
